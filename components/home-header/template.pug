header.notebook-homebar
  a.notebook-wordmark(href="/" aria-label="凌云首页")
    img.notebook-wordmark__image.notebook-wordmark__image--light(src=url_for("/img/notebook/wordmark.svg") alt="凌云 · LingyunAce")
    img.notebook-wordmark__image.notebook-wordmark__image--dark(src=url_for("/img/notebook/wordmark-dark.svg") alt="凌云 · LingyunAce")
  button.notebook-theme-toggle(type="button" data-theme-toggle aria-pressed="false" aria-label="切换到暗色主题") ◐

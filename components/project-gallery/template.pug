mixin workCard(project, isFeatured)
      if project.link
        a.notebook-project.notebook-card(class=isFeatured ? 'notebook-project--featured' : null
          data-project-tags=project.tags.join(',')
          href=project.link
        )
          .notebook-project__cover(style=`--project-accent: ${project.accent || '#4f7cff'}`)
            span.notebook-project__monogram(aria-hidden="true")= project.name.charAt(0)
            span.notebook-project__cover-name= project.name
            ul.notebook-project__cover-tags(aria-hidden="true")
              each tag in project.tags.slice(0, 3)
                li.notebook-project__cover-tag= tag
          .notebook-project__body
            h3= project.name
            p= project.desc
            ul.notebook-tags(aria-label="标签")
              each tag in project.tags
                li.notebook-tag= tag
            span.notebook-project__cta 阅读作品 →
      else
        article.notebook-project.notebook-card(class=isFeatured ? 'notebook-project--featured' : null data-project-tags=project.tags.join(','))
          .notebook-project__cover(style=`--project-accent: ${project.accent || '#4f7cff'}`)
            span.notebook-project__monogram(aria-hidden="true")= project.name.charAt(0)
            span.notebook-project__cover-name= project.name
            ul.notebook-project__cover-tags(aria-hidden="true")
              each tag in project.tags.slice(0, 3)
                li.notebook-project__cover-tag= tag
          .notebook-project__body
            h3= project.name
            p= project.desc
            ul.notebook-tags(aria-label="标签")
              each tag in project.tags
                li.notebook-tag= tag

- const projects = site.data.projects || []
- const sections = site.data.portfolio_sections || []
section.notebook-projects.notebook-shell(aria-labelledby="projects-title")
  header.notebook-page-heading
    p.notebook-kicker Projects
    h1#projects-title 作品集
    p 科幻创作、技术实践与人文随笔。

  each category in sections
    - const works = projects.filter(project => project.category === category.id)
    - const isFeatured = works.length === 1
    section.notebook-portfolio-section(aria-labelledby=`${category.id}-title`)
      header.notebook-portfolio-section__heading
        p.notebook-kicker= category.subtitle
        h2(id=`${category.id}-title`)= category.title
      .notebook-project-grid(class=isFeatured ? 'notebook-project-grid--featured' : null)
        each project in works
          +workCard(project, isFeatured)

mixin articleSort(posts)
  .notebook-archive-list
    - posts.forEach(article => {
      - const title = article.title || _p('no_title')
      article.notebook-archive-item
        time.notebook-archive-date(datetime=date(article.date, 'YYYY-MM-DD'))= date(article.date, 'MM.DD')
        .notebook-archive-copy
          a.notebook-archive-title(href=url_for(article.path) title=title)= title
          if article.description
            p.notebook-archive-description= article.description
    - })
